# Required
GROQ_API_KEY=your-groq-key
DATABASE_URL=postgresql://user:password@localhost:5432/codecrew

# Models (see README, "Models and Groq limits")
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_ARCHITECT=openai/gpt-oss-120b
# GROQ_TPM_LIMIT=12000

# Opening pull requests after approval (optional)
# GITHUB_TOKEN=ghp_...
# auto = push to the repo if you can, otherwise fork it and open the PR from
# the fork; or force direct / fork
# CODECREW_PUBLISH_MODE=auto
# CODECREW_GIT_NAME=CodeCrew
# CODECREW_GIT_EMAIL=codecrew@users.noreply.github.com

# Sandbox (optional)
# CODECREW_SANDBOX_IMAGE=codecrew-sandbox
# CODECREW_SANDBOX_CPUS=2.0
# CODECREW_SANDBOX_MEMORY=1g
